# Logs, caches, and temporary files
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
**/.cache/
.npm/
.eslintcache
tmp/
temp/
*.tmp
*.swp

# Editor and operating-system metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
